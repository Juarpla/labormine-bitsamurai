# Copy to .env and fill in what you have. Everything works without these.

# Google AdSense publisher id — when set in production, <AdSlot /> renders real units.
# Also replace the placeholder line in public/ads.txt with your id.
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional ingest source (free tier): https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
