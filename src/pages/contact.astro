---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../lib/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<Layout title={`${t('contact.title')} — Labormine`} description={t('footer.tagline')} locale={locale} path="/contact">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-graphite-100">{t('contact.title')}</h1>
    <p class="mt-6 leading-relaxed text-graphite-200">
      {t('contact.body')}
      <a class="text-brand-400 hover:underline" href="mailto:contact@labormine.com">contact@labormine.com</a>
    </p>
  </article>
</Layout>
