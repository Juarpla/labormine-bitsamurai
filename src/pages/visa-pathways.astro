---
import Layout from '../layouts/Layout.astro';
import PathwaysView from '../components/pages/PathwaysView.astro';
import { useTranslations } from '../lib/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<Layout title={`${t('pathways.title')} — Labormin`} description={t('pathways.lead')} locale={locale} path="/visa-pathways">
  <PathwaysView locale={locale} />
</Layout>
