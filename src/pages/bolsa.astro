---
import Layout from '../layouts/Layout.astro';
import BolsaView from '../components/pages/BolsaView.astro';
import { useTranslations } from '../lib/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<Layout title={`${t('bolsa.title')} — Labormin`} description={t('bolsa.lead')} locale={locale} path="/bolsa">
  <BolsaView locale={locale} />
</Layout>
