---
// Ops panel (ruta interna) — cola de flags de ubicación del ingest.
// Acceso: Cloudflare Access protege /ops/* al borde (OTP por email); esta
// página no renderiza nada sensible sin él y no forma parte del sitemap.
import flagsJson from '../../data/ingest-flags.json';
import overridesJson from '../../data/overrides.json';
import { miningCountries, GLOBAL, countryName } from '../../lib/i18n';

const flags = (flagsJson.flags ?? []) as Array<Record<string, unknown>>;
const excluded = (flagsJson.excluded ?? []) as Array<Record<string, unknown>>;
const corrections = Object.keys(overridesJson.corrections ?? {}).length;
const manualExcludes = Object.keys(overridesJson.exclude ?? {}).length;
const dismissed = Object.keys(overridesJson.dismissed ?? {}).length;
const countryOptions = [...miningCountries.map((c) => c.code), GLOBAL];
const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Labormin · Ops flags</title>
  </head>
  <body class="min-h-screen bg-graphite-950 px-4 py-8 text-graphite-100">
    <main class="mx-auto max-w-5xl">
      <header class="mb-6">
        <h1 class="text-2xl font-semibold tracking-tight">Ops · Flags de ubicación</h1>
        <p class="mt-1 text-sm text-graphite-400">
          Cola generada por <code class="text-graphite-200">scripts/ingest.mjs</code> el
          {flagsJson.generatedAt || '—'} · correcciones activas: {corrections} · exclusiones
          manuales: {manualExcludes} · descartadas: {dismissed}
        </p>
      </header>

      {flags.length === 0 ? (
        <p class="rounded-2xl border border-graphite-700 bg-graphite-900 p-6 text-sm text-graphite-400">
          Sin flags abiertos. El ingest flaggea empleos con país almacenado que la ubicación no
          corrobora (la ubicación no nombra ningún país).
        </p>
      ) : (
        <ul class="space-y-3" id="flag-list">
          {flags.map((f) => (
            <li
              class="rounded-2xl border border-graphite-700 bg-graphite-900 p-4"
              data-flag-row
              data-id={f.id}
            >
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <a
                    class="font-medium text-graphite-100 underline decoration-graphite-600 underline-offset-2"
                    href={`/jobs/${f.slug}`}
                    target="_blank"
                    rel="noopener"
                  >
                    {esc(f.title)}
                  </a>
                  <p class="text-sm text-graphite-400">
                    {esc(f.company)} · {esc(f.source)} ·
                    <span class="text-graphite-200">país almacenado: {esc(f.country)}</span>
                  </p>
                  <p class="mt-1 break-words text-sm text-graphite-200">
                    ubicación fuente: “{esc(f.locationRaw)}”
                    {f.remote ? ' · remote' : ''}
                  </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <select
                    class="rounded-xl border border-graphite-700 bg-graphite-800 px-3 py-2 text-sm outline-none focus:border-brand-500"
                    data-country-select
                  >
                    {countryOptions.map((c) => (
                      <option value={c} selected={c === f.country}>
                        {c === GLOBAL ? 'GLOBAL' : countryName(c)}
                      </option>
                    ))}
                  </select>
                  <button
                    class="rounded-xl bg-brand-500 px-3 py-2 text-sm font-semibold text-graphite-950 hover:bg-brand-400"
                    data-action="correct"
                  >
                    Guardar país
                  </button>
                  <button
                    class="rounded-xl border border-graphite-600 px-3 py-2 text-sm hover:border-brand-500"
                    data-action="exclude"
                  >
                    Excluir del feed
                  </button>
                  <button
                    class="rounded-xl border border-graphite-700 px-3 py-2 text-sm text-graphite-400 hover:text-graphite-200"
                    data-action="dismiss"
                  >
                    Descartar
                  </button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}

      {excluded.length > 0 && (
        <details class="mt-8 rounded-2xl border border-graphite-700 bg-graphite-900 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-graphite-200">
            Excluidos automáticamente por ubicación no soportada ({excluded.length})
          </summary>
          <ul class="mt-3 space-y-2 text-sm text-graphite-400">
            {excluded.map((e) => (
              <li class="break-words">
                {esc(e.company)} · {esc(e.title)} · “{esc(e.locationRaw)}” ·
                <span class="text-graphite-200">{esc(e.reason)}</span>
              </li>
            ))}
          </ul>
        </details>
      )}

      <p id="toast" class="pointer-events-none fixed bottom-4 left-1/2 -translate-x-1/2 rounded-xl bg-graphite-800 px-4 py-2 text-sm text-graphite-100 opacity-0 shadow-lg transition-opacity"></p>
    </main>

    <script>
      const toastEl = document.getElementById('toast');
      function toast(message, isError = false) {
        if (!toastEl) return;
        toastEl.textContent = message;
        toastEl.style.color = isError ? '#ffc247' : '';
        toastEl.style.opacity = '1';
        clearTimeout(toast._t);
        toast._t = setTimeout(() => (toastEl.style.opacity = '0'), 4000);
      }

      async function act(id, action, country) {
        const res = await fetch('/ops/api/act', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, action, country }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
        return data.message;
      }

      document.querySelectorAll('[data-flag-row]').forEach((row) => {
        const id = row.getAttribute('data-id');
        row.querySelectorAll('[data-action]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const action = btn.getAttribute('data-action');
            if (action === 'exclude' && !confirm(`¿Excluir "${id}" del feed? No volverá a publicarse.`)) return;
            row.querySelectorAll('button, select').forEach((el) => (el.disabled = true));
            try {
              const country = row.querySelector('[data-country-select]')?.value;
              const message = await act(id, action, country);
              row.remove();
              toast(message);
            } catch (err) {
              toast(`Error: ${err.message}`, true);
            } finally {
              row.querySelectorAll('button, select').forEach((el) => (el.disabled = false));
            }
          });
        });
      });
    </script>
  </body>
</html>
