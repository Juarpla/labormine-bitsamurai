---
import Layout from '../../../layouts/Layout.astro';
import JobsView from '../../../components/pages/JobsView.astro';
import { useTranslations } from '../../../lib/i18n';

const locale = 'pt' as const;
const t = useTranslations(locale);
---

<Layout title={`${t('jobs.title')} — Labormine`} description={t('jobs.lead')} locale={locale} path="/jobs">
  <JobsView locale={locale} />
</Layout>
