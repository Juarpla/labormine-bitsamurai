---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../lib/i18n';

const t = useTranslations('es');
---

<Layout title={`${t('notfound.title')} — Labormine`} description={t('notfound.body')} locale="es" path="/404">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <h1 class="font-display text-6xl font-semibold text-brand-500">{t('notfound.title')}</h1>
    <p class="mt-4 text-graphite-400">{t('notfound.body')}</p>
    <a href="/" class="mt-8 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 hover:bg-brand-400">
      {t('notfound.cta')}
    </a>
  </section>
</Layout>
