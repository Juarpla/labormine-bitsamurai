---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import { useTranslations } from '../lib/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<Layout title={`${t('about.title')} — Labormin`} description={t('footer.tagline')} locale={locale} path="/about">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-graphite-100">{t('about.title')}</h1>
    <p class="mt-6 leading-relaxed text-graphite-200">{t('about.body')}</p>
    <p class="mt-4 rounded-2xl border border-brand-600/40 bg-brand-500/5 p-5 leading-relaxed text-graphite-200">
      ✦ {t('about.realJobs')}
    </p>
  </article>

  <div class="pb-4">
    <AdSlot
      slotId="about-bottom-desktop-1"
      size={{ w: 970, h: 90 }}
      media="(min-width: 1024px)"
      locale={locale}
      class="mx-auto w-fit hidden lg:block"
    />
    <AdSlot
      slotId="about-bottom-mobile-1"
      size={{ w: 320, h: 100 }}
      media="(max-width: 1023.98px)"
      locale={locale}
      class="mx-auto w-fit lg:hidden"
    />
  </div>
</Layout>
