---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../lib/i18n';

const t = useTranslations('en');
---

<Layout title={`${t('about.title')} — Labormine`} description={t('footer.tagline')} locale="en" path="/about">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-graphite-100">{t('about.title')}</h1>
    <p class="mt-6 leading-relaxed text-graphite-200">{t('about.body')}</p>
    <p class="mt-4 rounded-2xl border border-brand-600/40 bg-brand-500/5 p-5 leading-relaxed text-graphite-200">
      ✦ {t('about.realJobs')}
    </p>
  </article>
</Layout>
