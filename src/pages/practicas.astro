---
import Layout from '../layouts/Layout.astro';
import PracticasView from '../components/pages/PracticasView.astro';
import { useTranslations } from '../lib/i18n';

const locale = 'es' as const;
const t = useTranslations(locale);
---

<Layout
  title={`${t('practicas.title')} en Perú | Labormin`}
  description={t('practicas.lead')}
  locale={locale}
  path="/practicas"
>
  <PracticasView locale={locale} />
</Layout>
