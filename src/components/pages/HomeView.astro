---
import pathways from '../../data/pathways.json';
import Chapter from '../Chapter.astro';
import JobCard from '../JobCard.astro';
import AdSlot from '../AdSlot.astro';
import CountrySelector from '../CountrySelector.astro';
import JobDrawer from '../JobDrawer.astro';
import { useTranslations, localePath, countryName, type Locale } from '../../lib/i18n';
import { jobIndex, spotlightCountries, remoteJobs, byCountry } from '../../lib/jobs';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

const index = jobIndex();
const spotlights = spotlightCountries(3);
const remotes = remoteJobs().slice(0, 6);

const nationalityOptions = [...new Set(pathways.pathways.flatMap((p) => p.eligibleNationalities ?? []))]
  .sort()
  .map((code) => {
    try {
      return { code, name: new Intl.DisplayNames([locale], { type: 'region' }).of(code) ?? code };
    } catch {
      return { code, name: code };
    }
  });

const payload = JSON.stringify({
  locale,
  index,
  pathways: pathways.pathways,
  msgs: {
    visa: t('card.visa'),
    remote: t('card.remote'),
    global: t('card.global'),
    selectPrompt: t('common.selectPrompt'),
    passportCta: t('chapter.passport.cta'),
    pathwaysNone: t('pathways.none'),
    eligibleBadge: t('pathways.badge'),
    age: t('pathways.age'),
    duration: t('pathways.duration'),
    official: t('pathways.official'),
    viewAll: t('common.viewAll'),
  },
});
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(245,166,35,0.13),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto flex min-h-[82vh] max-w-6xl flex-col justify-center px-4 py-20 sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-500">{t('hero.kicker')}</p>
    <h1 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.1] text-graphite-100 sm:text-6xl">
      {t('hero.title')}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-graphite-400">{t('hero.subtitle')}</p>

    <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
      <CountrySelector
        locale={locale}
        mode="nationality"
        options={nationalityOptions}
        label={t('hero.nationality')}
        id="hero-nationality"
      />
      <CountrySelector locale={locale} mode="country" label={t('hero.country')} id="hero-country" />
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={localePath(locale, '/jobs')}
        class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
      >
        {t('hero.cta')}
      </a>
      <a
        href={localePath(locale, '/visa-pathways')}
        class="rounded-full border border-graphite-600 px-6 py-3 text-sm font-semibold text-graphite-100 transition-colors hover:border-brand-500"
      >
        {t('hero.secondary')}
      </a>
    </div>
  </div>
</section>

<Chapter kicker={t('chapter.inCountry.kicker')} title={t('chapter.inCountry.title')} lead={t('chapter.inCountry.lead')} id="chapter-country-section">
  <div id="chapter-country" class="grid gap-4 sm:grid-cols-2">
    <div class="skeleton h-40"></div>
    <div class="skeleton h-40"></div>
    <div class="skeleton h-40"></div>
    <div class="skeleton h-40"></div>
  </div>
</Chapter>

<Chapter kicker={t('chapter.passport.kicker')} title={t('chapter.passport.title')} lead={t('chapter.passport.lead')}>
  <div id="chapter-passport" class="grid gap-4 sm:grid-cols-2">
    <div class="skeleton h-40"></div>
    <div class="skeleton h-40"></div>
  </div>
  <a href={localePath(locale, '/visa-pathways')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('chapter.passport.cta')} →
  </a>
</Chapter>

<AdSlot slotId="home-spotlight-1" format="fluid" layoutKey="-fb+5w+4e-db+86" locale={locale} />

{
  spotlights.map(({ code, count }) => {
    const countryJobs = byCountry(code).slice(0, 6);
    if (countryJobs.length === 0) return null;
    return (
      <Chapter
        kicker={t('chapter.spotlight.kicker')}
        title={`${countryName(code)} · ${count}`}
        id={`spotlight-${code}`}
      >
        <div class="grid gap-4 sm:grid-cols-2">
          {countryJobs.map((job) => (
            <JobCard job={job} locale={locale} />
          ))}
        </div>
        <a href={localePath(locale, '/jobs')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
          {t('common.viewAll')} →
        </a>
      </Chapter>
    );
  })
}

<AdSlot slotId="home-remote-1" format="auto" locale={locale} />

<Chapter kicker={t('chapter.remote.kicker')} title={t('chapter.remote.title')} lead={t('chapter.remote.lead')}>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      remotes.map((job) => (
        <JobCard job={job} locale={locale} />
      ))
    }
  </div>
</Chapter>

<section class="mx-auto max-w-6xl px-4 pb-32 sm:px-6">
  <div class="reveal rounded-3xl border border-brand-600/40 bg-gradient-to-b from-brand-500/10 to-transparent p-10 text-center sm:p-16">
    <h2 class="font-display text-3xl font-semibold text-graphite-100 sm:text-5xl">{t('chapter.cta.title')}</h2>
    <p class="mx-auto mt-4 max-w-xl text-graphite-400">{t('chapter.cta.body')}</p>
    <a
      href={localePath(locale, '/jobs')}
      class="mt-8 inline-block rounded-full bg-brand-500 px-8 py-4 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
    >
      {t('chapter.cta.button')}
    </a>
  </div>
</section>

<JobDrawer locale={locale} />

<script type="application/json" id="lm-data" set:html={payload} />

<script>
  // --- Client hydration for geo-dependent chapters ---
  type Entry = {
    id: string; slug: string; title: string; company: string; country: string;
    city: string | null; remote: boolean; visaReported: boolean; category: string;
    postedAt: string; salaryText: string | null; excerpt: string;
  };
  type Pathway = {
    id: string; name: string; type: string; country: string;
    eligibleNationalities: string[] | null; ageRange: string | null;
    duration: string; workRights: string; officialUrl: string; lastVerifiedAt: string;
  };
  const data = JSON.parse(document.getElementById('lm-data')!.textContent!);
  const M = data.msgs;
  const prefix = data.locale === 'es' ? '' : `/${data.locale}`;
  window.__lmIndex = data.index;

  function renderCard(e: Entry): string {
    return `
      <article class="job-card flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-lg font-semibold leading-snug">
            <a href="${prefix}/jobs/${e.slug}" class="hover:text-brand-400">${e.title}</a>
          </h3>
          ${e.visaReported ? `<span class="shrink-0 rounded-full border border-brand-600/60 bg-brand-500/10 px-2.5 py-1 text-[11px] font-medium text-brand-400">✦ ${M.visa}</span>` : ''}
        </div>
        <p class="text-sm text-graphite-200"><span class="font-medium">${e.company}</span>
          <span class="text-graphite-400"> · ${e.city ?? M.global}</span></p>
        <div class="mt-auto flex flex-wrap items-center gap-2 text-xs text-graphite-400">
          <span class="rounded-full bg-graphite-800 px-2.5 py-1">${e.category}</span>
          ${e.remote ? `<span class="rounded-full bg-graphite-800 px-2.5 py-1 text-brand-300">↗ ${M.remote}</span>` : ''}
          ${e.salaryText ? `<span class="rounded-full bg-graphite-800 px-2.5 py-1">${e.salaryText}</span>` : ''}
        </div>
      </article>`;
  }

  function renderPathway(p: Pathway): string {
    return `
      <article class="flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-base font-semibold leading-snug">${p.name}</h3>
          <span class="shrink-0 rounded-full bg-graphite-800 px-2.5 py-1 text-[11px] text-graphite-300">${p.type}</span>
        </div>
        <ul class="space-y-1 text-xs text-graphite-400">
          ${p.ageRange ? `<li><span class="text-graphite-500">${M.age}:</span> ${p.ageRange}</li>` : ''}
          <li><span class="text-graphite-500">${M.duration}:</span> ${p.duration}</li>
        </ul>
        <div class="mt-auto flex gap-3">
          <a href="${prefix}/visa-pathways" class="text-xs font-semibold text-brand-400 hover:text-brand-300">${M.official} →</a>
        </div>
      </article>`;
  }

  function hydrate() {
    const geo = window.Labormine ?? { country: null, nationality: null };
    const countryEl = document.getElementById('chapter-country');
    const passportEl = document.getElementById('chapter-passport');
    if (!countryEl || !passportEl) return;

    const dest = geo.country && geo.country !== 'GLOBAL' ? geo.country : null;
    const nat = geo.nationality || null;
    const forYou = nat
      ? data.pathways.filter(
          (p: Pathway) => p.eligibleNationalities === null || p.eligibleNationalities.includes(nat)
        )
      : [];

    // Chapter 1 — jobs matched to the destination country, or (with destination on
    // Global) to your passport: home country first, then countries with an eligible
    // visa pathway, then remote roles.
    let mine: Entry[] = [];
    let note = '';
    if (dest) {
      mine = data.index.filter((e: Entry) => e.country === dest);
      const countryPathways = data.pathways.filter((p: Pathway) => p.country === dest);
      if (countryPathways.length)
        note = `<p class="text-xs text-brand-400 sm:col-span-2">✦ ${countryPathways
          .map((p: Pathway) => p.name)
          .join(' · ')}</p>`;
    } else if (nat) {
      const visaCountries = new Set(forYou.map((p: Pathway) => p.country));
      const home: Entry[] = [];
      const abroad: Entry[] = [];
      const remote: Entry[] = [];
      for (const e of data.index as Entry[]) {
        if (e.country === nat) home.push(e);
        else if (visaCountries.has(e.country)) abroad.push(e);
        else if (e.remote) remote.push(e);
      }
      mine = [...home, ...abroad, ...remote].slice(0, 6);
      if (forYou.length)
        note = `<p class="text-xs text-brand-400 sm:col-span-2">✦ ${forYou
          .slice(0, 3)
          .map((p: Pathway) => p.name)
          .join(' · ')}</p>`;
    }
    countryEl.innerHTML =
      (mine.length
        ? mine.map((e: Entry) => renderCard(e)).join('')
        : `<p class="text-sm text-graphite-400 sm:col-span-2">${M.selectPrompt}</p>`) + note;

    // Chapter 2 — pathways for your nationality
    if (nat) {
      passportEl.innerHTML =
        forYou.slice(0, 4).map((p: Pathway) => renderPathway(p)).join('') ||
        `<p class="text-sm text-graphite-400 sm:col-span-2">${M.pathwaysNone}</p>`;
    } else {
      passportEl.innerHTML = `<p class="text-sm text-graphite-400 sm:col-span-2">${M.selectPrompt}</p>`;
    }
  }

  document.addEventListener('lm:geo', hydrate);
  hydrate();
</script>
