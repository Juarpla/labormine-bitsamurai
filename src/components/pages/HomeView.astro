---
import pathways from '../../data/pathways.json';
import Chapter from '../Chapter.astro';
import JobCard from '../JobCard.astro';
import AdSlot from '../AdSlot.astro';
import JobDrawer from '../JobDrawer.astro';
import SectorPulse from '../SectorPulse.astro';
import StocksPulse from '../StocksPulse.astro';
import { useTranslations, localePath, DEFAULT_NATIONALITY, type Locale } from '../../lib/i18n';
import { jobIndex, byCountry, remoteJobs, tierOf, jobs, generatedAt } from '../../lib/jobs';
import { upcomingEvents } from '../../lib/events';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

const index = jobIndex(locale);

// Nicho fijo: Perú (sin detección por IP ni selectores).
const peJobs = byCountry('PE');
const heroJobs = peJobs.slice(0, 3); // el arranque muestra lo más fresco
const peChapterJobs = peJobs.slice(3, 9); // el capítulo continúa donde el hero termina
const remotes = remoteJobs().slice(0, 6);
const abroad = jobs
  .filter((j) => tierOf(j) === 3)
  .slice(0, 6);

// Cifras reales del feed (nunca inventadas): el arranque informa antes de vender.
const peCount = peJobs.length;
const remoteCount = remoteJobs().length;
const abroadCount = jobs.filter((j) => tierOf(j) === 3).length;
const fmtCount = (n: number) => new Intl.NumberFormat('es-PE').format(n);
const feedUpdatedAt = new Intl.DateTimeFormat('es-PE', { dateStyle: 'long' }).format(
  new Date(generatedAt)
);

// Rutas de visa abiertas a peruanos
const pePathways = pathways.pathways.filter(
  (p) => !p.eligibleNationalities || p.eligibleNationalities.includes(DEFAULT_NATIONALITY)
);

// Eventos mineros próximos (curados a mano)
const events = upcomingEvents().slice(0, 3);
const fmtEventDate = (iso: string) =>
  new Intl.DateTimeFormat('es-PE', { dateStyle: 'long' }).format(new Date(iso));

const payload = JSON.stringify({
  locale,
  index,
  msgs: {
    quick: t('drawer.quick'),
    full: t('drawer.full'),
    apply: t('drawer.apply'),
  },
});
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(245,166,35,0.13),transparent_70%)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-16 lg:pb-28 lg:pt-24">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
      <div>
        <h1 class="max-w-2xl font-display text-4xl font-semibold leading-[1.08] tracking-tight text-balance text-graphite-100 sm:text-5xl xl:text-6xl">
          {t('hero.title')}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-graphite-400">{t('hero.subtitle')}</p>

        <dl class="mt-10 grid max-w-xl grid-cols-3 divide-x divide-graphite-800">
          <div class="pr-4">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-graphite-400">{t('hero.tier.pe')}</dt>
            <dd class="mt-2">
              <span class="block font-display text-3xl font-semibold text-graphite-100">{fmtCount(peCount)}</span>
              <span class="mt-1 block text-xs leading-snug text-graphite-400">{t('hero.tier.pe.desc')}</span>
            </dd>
          </div>
          <div class="px-4">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-graphite-400">{t('hero.tier.remote')}</dt>
            <dd class="mt-2">
              <span class="block font-display text-3xl font-semibold text-graphite-100">{fmtCount(remoteCount)}</span>
              <span class="mt-1 block text-xs leading-snug text-graphite-400">{t('hero.tier.remote.desc')}</span>
            </dd>
          </div>
          <div class="pl-4">
            <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-graphite-400">{t('hero.tier.abroad')}</dt>
            <dd class="mt-2">
              <span class="block font-display text-3xl font-semibold text-graphite-100">{fmtCount(abroadCount)}</span>
              <span class="mt-1 block text-xs leading-snug text-graphite-400">{t('hero.tier.abroad.desc')}</span>
            </dd>
          </div>
        </dl>
        <p class="mt-4 text-xs text-graphite-400">Feed actualizado el {feedUpdatedAt}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={localePath(locale, '/jobs')}
            class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
          >
            {t('hero.cta')}
          </a>
          <a
            href={localePath(locale, '/visa-pathways')}
            class="rounded-full border border-graphite-600 px-6 py-3 text-sm font-semibold text-graphite-100 transition-colors hover:border-brand-500"
          >
            {t('hero.secondary')}
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-base font-semibold text-graphite-100">{t('hero.fresh.title')}</h2>
          <a
            href={localePath(locale, '/jobs')}
            class="shrink-0 text-xs font-semibold text-brand-400 transition-colors hover:text-brand-300"
          >
            {t('common.viewAll')} →
          </a>
        </div>
        {heroJobs.map((job) => <JobCard job={job} locale={locale} />)}
      </div>
    </div>
  </div>
</section>

<Chapter kicker={t('chapter.inCountry.kicker')} title={t('chapter.inCountry.title')} lead={t('chapter.inCountry.lead')} id="chapter-pe-section">
  <div class="grid gap-4 sm:grid-cols-2">
    {peChapterJobs.map((job) => <JobCard job={job} locale={locale} />)}
  </div>
  <a href={localePath(locale, '/jobs')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('common.viewAll')} →
  </a>
</Chapter>

<SectorPulse locale={locale} />

<StocksPulse locale={locale} />

<Chapter kicker={t('chapter.events.kicker')} title={t('chapter.events.title')} lead={t('chapter.events.lead')}>
  <div class="grid gap-4 sm:grid-cols-3">
    {
      events.map((e) => (
        <article class="flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-500">{e.mode === 'presencial' ? 'Presencial' : 'Virtual'} · {e.city ?? ''}</p>
          <h3 class="font-display text-base font-semibold leading-snug text-graphite-100">{e.title}</h3>
          <p class="text-xs text-graphite-400">📅 {fmtEventDate(e.date)}</p>
          <a
            href={e.officialUrl}
            target="_blank"
            rel="noopener nofollow"
            class="mt-auto text-xs font-semibold text-brand-400 hover:text-brand-300"
          >
            {t('events.official')} ↗
          </a>
        </article>
      ))
    }
  </div>
  <a href={localePath(locale, '/eventos')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('common.viewAll')} →
  </a>
</Chapter>

<AdSlot slotId="home-spotlight-1" format="fluid" layoutKey="-fb+5w+4e-db+86" locale={locale} />

<Chapter kicker={t('chapter.remote.kicker')} title={t('chapter.remote.title')} lead={t('chapter.remote.lead')}>
  <div class="grid gap-4 sm:grid-cols-2">
    {remotes.map((job) => <JobCard job={job} locale={locale} />)}
  </div>
</Chapter>

<AdSlot slotId="home-remote-1" format="auto" locale={locale} />

<Chapter kicker={t('chapter.abroad.kicker')} title={t('chapter.abroad.title')} lead={t('chapter.abroad.lead')}>
  <div class="grid gap-4 sm:grid-cols-2">
    {abroad.map((job) => <JobCard job={job} locale={locale} />)}
  </div>
</Chapter>

<Chapter kicker={t('chapter.passport.kicker')} title={t('chapter.passport.title')} lead={t('chapter.passport.lead')}>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      pePathways.slice(0, 4).map((p) => (
        <article class="flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-base font-semibold leading-snug text-graphite-100">{p.name}</h3>
            <span class="shrink-0 rounded-full bg-graphite-800 px-2.5 py-1 text-[11px] text-graphite-300">{p.type}</span>
          </div>
          <p class="text-xs text-graphite-400">
            {p.ageRange ? `Edad: ${p.ageRange} · ` : ''}{p.duration}
          </p>
          <a
            href={p.officialUrl}
            target="_blank"
            rel="noopener nofollow"
            class="mt-auto text-xs font-semibold text-brand-400 hover:text-brand-300"
          >
            {t('pathways.official')} ↗
          </a>
        </article>
      ))
    }
  </div>
  <a href={localePath(locale, '/visa-pathways')} class="mt-6 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300">
    {t('chapter.passport.cta')} →
  </a>
</Chapter>

<Chapter kicker={t('chapter.guides.kicker')} title={t('chapter.guides.title')} lead={t('chapter.guides.lead')}>
  <div class="grid gap-4 sm:grid-cols-2">
    <a
      href={localePath(locale, '/guias')}
      class="group flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-6 transition-colors hover:border-brand-500"
    >
      <h3 class="font-display text-lg font-semibold text-graphite-100 group-hover:text-brand-400">📚 {t('nav.guias')}</h3>
      <p class="text-sm text-graphite-400">{t('chapter.guides.lead')}</p>
    </a>
    <a
      href={localePath(locale, '/faq')}
      class="group flex flex-col gap-2 rounded-2xl border border-graphite-800 bg-graphite-900 p-6 transition-colors hover:border-brand-500"
    >
      <h3 class="font-display text-lg font-semibold text-graphite-100 group-hover:text-brand-400">❓ FAQ</h3>
      <p class="text-sm text-graphite-400">{t('faq.teaser')}</p>
    </a>
  </div>
</Chapter>

<section class="mx-auto max-w-6xl px-4 pb-32 sm:px-6">
  <div class="reveal rounded-3xl border border-brand-600/40 bg-gradient-to-b from-brand-500/10 to-transparent p-10 text-center sm:p-16">
    <h2 class="font-display text-3xl font-semibold text-graphite-100 sm:text-5xl">{t('chapter.cta.title')}</h2>
    <p class="mx-auto mt-4 max-w-xl text-graphite-400">{t('chapter.cta.body')}</p>
    <a
      href={localePath(locale, '/jobs')}
      class="mt-8 inline-block rounded-full bg-brand-500 px-8 py-4 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
    >
      {t('chapter.cta.button')}
    </a>
  </div>
</section>

<JobDrawer locale={locale} />

<script type="application/json" id="lm-data" set:html={payload} />

<script>
  // Solo el drawer necesita el índice de empleos (las tarjetas ya son estáticas).
  const data = JSON.parse(document.getElementById('lm-data')!.textContent!);
  window.__lmIndex = data.index;
</script>
