---
import pathwaysRaw from '../../data/pathways.json';
import AdSlot from '../AdSlot.astro';
import { useTranslations, countryName, defaultLocale, type Locale } from '../../lib/i18n';
import { DEFAULT_NATIONALITY } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const typeLabel: Record<string, string> = {
  'working-holiday': t('pathway.working-holiday'),
  temporary: t('pathway.temporary'),
  student: t('pathway.student'),
  sponsorship: t('pathway.sponsorship'),
  skilled: t('pathway.skilled'),
};

// Nicho: solo rutas abiertas a peruanos (eligibleNationalities null = todas).
const pathways = pathwaysRaw.pathways.filter(
  (p) => !p.eligibleNationalities || p.eligibleNationalities.includes(DEFAULT_NATIONALITY)
);
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <h1 class="font-display text-4xl font-semibold text-graphite-100 sm:text-5xl">{t('pathways.title')}</h1>
  <p class="mt-4 max-w-2xl text-graphite-400">{t('pathways.lead')}</p>

  <h2 class="mt-12 font-display text-2xl font-semibold text-graphite-100">
    {t('pathways.forYou', { nationality: countryName(DEFAULT_NATIONALITY) })}
  </h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      pathways.map((p) => (
        <article class="flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-lg font-semibold leading-snug text-graphite-100">{p.name}</h3>
            <span class="shrink-0 rounded-full bg-graphite-800 px-2.5 py-1 text-[11px] text-graphite-300">
              {typeLabel[p.type] ?? p.type}
            </span>
          </div>
          <p class="text-sm text-graphite-300">🌍 {countryName(p.country)}</p>
          <dl class="space-y-1.5 text-xs text-graphite-400">
            {p.ageRange && (
              <div><dt class="inline text-graphite-500">{t('pathways.age')}: </dt><dd class="inline">{p.ageRange}</dd></div>
            )}
            <div><dt class="inline text-graphite-500">{t('pathways.duration')}: </dt><dd class="inline">{p.duration}</dd></div>
            <div><dt class="inline text-graphite-500">{t('pathways.rights')}: </dt><dd class="inline">{p.workRights}</dd></div>
            <div><dt class="inline text-graphite-500">{t('pathways.any')}: </dt><dd class="inline">
              {p.eligibleNationalities === null
                ? t('pathways.any')
                : p.eligibleNationalities.length === 1
                  ? countryName(p.eligibleNationalities[0])
                  : `${p.eligibleNationalities.length} nacionalidades`}
            </dd></div>
          </dl>
          {p.notes && (
            <p class="rounded-xl border border-graphite-700 bg-graphite-850 p-3 text-xs leading-relaxed text-graphite-400">
              {t('pathways.notes')}: {p.notes}
            </p>
          )}
          <div class="mt-auto flex items-center justify-between gap-3 pt-2">
            <a
              href={p.officialUrl}
              target="_blank"
              rel="noopener nofollow"
              class="rounded-full bg-brand-500 px-4 py-2 text-xs font-semibold text-graphite-950 hover:bg-brand-400"
            >
              {t('pathways.official')} ↗
            </a>
            <span class="text-[11px] text-graphite-500">
              {t('pathways.verified', { date: p.lastVerifiedAt })}
            </span>
          </div>
        </article>
      ))
    }
  </div>

  <AdSlot slotId="pathways-1" format="auto" locale={locale} />
</section>
