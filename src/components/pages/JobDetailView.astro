---
import type { Job } from '../../schemas';
import AdSlot from '../AdSlot.astro';
import JobCard from '../JobCard.astro';
import { useTranslations, countryName, type Locale } from '../../lib/i18n';
import { formatSalary, formatDate, relatedJobs } from '../../lib/jobs';

interface Props {
  job: Job;
  locale?: Locale;
}
const { job, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const related = relatedJobs(job, 3);
const backHref = locale === 'en' ? '/jobs' : `/${locale}/jobs`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: job.excerpt,
  datePosted: job.postedAt,
  employmentType: 'FULL_TIME',
  ...(job.remote
    ? { jobLocationType: 'TELECOMMUTE' }
    : { jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: job.country } } }),
  hiringOrganization: { '@type': 'Organization', name: job.company },
  ...(job.salary
    ? {
        baseSalary: {
          '@type': 'MonetaryAmount',
          currency: job.salary.currency,
          value: {
            '@type': 'QuantitativeValue',
            unitText: job.salary.period.toUpperCase(),
            ...(job.salary.max
              ? { minValue: job.salary.min, maxValue: job.salary.max }
              : { value: job.salary.min }),
          },
        },
      }
    : {}),
  directApply: false,
};
---

<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
  <nav class="text-sm text-graphite-400" aria-label="Breadcrumb">
    <a href={backHref} class="hover:text-brand-400">← {t('common.back')}</a>
  </nav>

  <header class="mt-6">
    <div class="flex flex-wrap items-center gap-2 text-xs text-graphite-400">
      <span class="rounded-full bg-graphite-800 px-2.5 py-1">{job.category}</span>
      <span class="rounded-full bg-graphite-800 px-2.5 py-1">{job.source}</span>
      {job.remote && <span class="rounded-full bg-graphite-800 px-2.5 py-1 text-brand-300">↗ {t('card.remote')}</span>}
      <time datetime={job.postedAt}>{t('card.posted')} {formatDate(job.postedAt, locale)}</time>
    </div>
    <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
      {job.title}
    </h1>
    <p class="mt-3 text-lg text-graphite-200">
      <span class="font-medium">{job.company}</span>
      <span class="text-graphite-400"> · {job.city ?? t('card.global')} · {countryName(job.country)}</span>
    </p>
    {job.salary && (
      <p class="mt-2 text-sm font-semibold text-brand-400">{formatSalary(job)}</p>
    )}

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={job.url}
        target="_blank"
        rel="noopener nofollow"
        class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-graphite-950 transition-colors hover:bg-brand-400"
      >
        {t('drawer.apply')} ↗
      </a>
      {job.visaReported && (
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-600/60 bg-brand-500/10 px-4 py-3 text-xs font-medium text-brand-400">
          ✦ {t('card.visa')}
        </span>
      )}
    </div>
  </header>

  {job.visaReported && (
    <p class="mt-6 rounded-xl border border-graphite-700 bg-graphite-900 p-4 text-sm text-graphite-400">
      ℹ {t('drawer.visaNote')}
    </p>
  )}

  <AdSlot slotId="job-detail-1" format="horizontal" locale={locale} />

  <div class="prose-invert mt-8 max-w-none space-y-4 text-base leading-relaxed text-graphite-200 [&_a]:text-brand-400">
    <Fragment set:html={job.description} />
  </div>

  <div class="mt-10">
    <a
      href={job.url}
      target="_blank"
      rel="noopener nofollow"
      class="inline-block rounded-full border border-graphite-600 px-6 py-3 text-sm font-semibold text-graphite-100 transition-colors hover:border-brand-500"
    >
      {t('drawer.apply')} ↗
    </a>
  </div>

  {related.length > 0 && (
    <section class="mt-16">
      <h2 class="font-display text-2xl font-semibold text-graphite-100">{t('common.related')}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => <JobCard job={r} locale={locale} />)}
      </div>
    </section>
  )}
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
