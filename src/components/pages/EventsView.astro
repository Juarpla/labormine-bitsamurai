---
import AdSlot from '../AdSlot.astro';
import { useTranslations, countryName, defaultLocale, type Locale } from '../../lib/i18n';
import { upcomingEvents, events } from '../../lib/events';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);

const list = upcomingEvents();
const modeLabel: Record<string, string> = {
  presencial: t('events.mode.presencial'),
  virtual: t('events.mode.virtual'),
};
const typeLabel: Record<string, string> = {
  'feria-laboral': t('events.type.feria-laboral'),
  expo: t('events.type.expo'),
  conferencia: t('events.type.conferencia'),
  webinar: t('events.type.webinar'),
};
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat('es-PE', { dateStyle: 'medium' }).format(new Date(iso));
---

<div class="xl:grid xl:grid-cols-[160px_56rem_160px] xl:justify-center xl:gap-4">
  <AdSlot
    slotId="events-side-1"
    size={{ w: 160, h: 600 }}
    media="(min-width: 1280px)"
    locale={locale}
    class="sticky top-24 hidden w-fit self-start xl:block"
  />
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
  <h1 class="font-display text-4xl font-semibold text-graphite-100 sm:text-5xl">{t('events.title')}</h1>
  <p class="mt-4 max-w-2xl text-graphite-400">{t('events.lead')}</p>

  <AdSlot
    slotId="events-top-1"
    size={{ w: 320, h: 50 }}
    media="(max-width: 1023.98px)"
    locale={locale}
    class="mx-auto w-fit lg:hidden"
  />

  <h2 class="mt-12 font-display text-2xl font-semibold text-graphite-100">{t('events.upcoming')}</h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      list.length === 0 && (
        <p class="text-sm text-graphite-400 sm:col-span-2">{t('events.empty')}</p>
      )
    }
    {
      list.map((e) => (
        <article class="flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-lg font-semibold leading-snug text-graphite-100">{e.title}</h3>
            <span class="shrink-0 rounded-full bg-graphite-800 px-2.5 py-1 text-[11px] text-graphite-300">
              {modeLabel[e.mode]} · {typeLabel[e.type]}
            </span>
          </div>
          <p class="text-sm text-graphite-200">
            📅 <time datetime={e.date}>{new Intl.DateTimeFormat('es-PE', { dateStyle: 'long' }).format(new Date(e.date))}</time>
            <span class="text-graphite-400"> · {e.city ?? ''}{e.city ? ', ' : ''}{countryName(e.country)}</span>
          </p>
          {e.notes && (
            <p class="rounded-xl border border-graphite-700 bg-graphite-850 p-3 text-xs leading-relaxed text-graphite-400">
              {e.notes}
            </p>
          )}
          <div class="mt-auto flex items-center justify-between gap-3 pt-2">
            <a
              href={e.officialUrl}
              target="_blank"
              rel="noopener nofollow"
              class="rounded-full bg-brand-500 px-4 py-2 text-xs font-semibold text-graphite-950 hover:bg-brand-400"
            >
              {t('events.official')} ↗
            </a>
            <span class="text-[11px] text-graphite-500">
              {t('events.updated', { date: e.lastVerifiedAt })}
            </span>
          </div>
        </article>
      ))
    }
  </div>

  {
    events.length === 0 && (
      <p class="mt-10 text-center text-graphite-400">{t('events.empty')}</p>
    )
  }

  <p class="mt-8 text-xs leading-relaxed text-graphite-500">
    ℹ {t('events.lead')}
  </p>
</section>

  <AdSlot
    slotId="events-side-2"
    size={{ w: 160, h: 600 }}
    media="(min-width: 1280px)"
    locale={locale}
    class="sticky top-24 hidden w-fit self-start xl:block"
  />
</div>

<div class="pb-4">
  <AdSlot
    slotId="events-bottom-desktop-1"
    size={{ w: 970, h: 90 }}
    media="(min-width: 1024px)"
    locale={locale}
    class="mx-auto w-fit hidden lg:block"
  />
  <AdSlot
    slotId="events-bottom-mobile-1"
    size={{ w: 320, h: 100 }}
    media="(max-width: 1023.98px)"
    locale={locale}
    class="mx-auto w-fit lg:hidden"
  />
</div>
