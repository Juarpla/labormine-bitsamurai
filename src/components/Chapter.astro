---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
  id?: string;
  class?: string;
  full?: boolean;
}
const { kicker, title, lead, id, full = false, class: className = '' } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-36', className]}>
  {
    full ? (
      <>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">{kicker}</p>
        <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
          {title}
        </h2>
        {lead && <p class="mt-4 max-w-md text-base leading-relaxed text-graphite-400">{lead}</p>}
        <div class="reveal mt-12">
          <slot />
        </div>
      </>
    ) : (
      <div class="grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        <div class="sticky-text">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">{kicker}</p>
          <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
            {title}
          </h2>
          {lead && <p class="mt-4 max-w-md text-base leading-relaxed text-graphite-400">{lead}</p>}
        </div>
        <div class="reveal">
          <slot />
        </div>
      </div>
    )
  }
</section>
