---
import { useTranslations, type Locale } from '../lib/i18n';
import { stocks, topPerformers, extremes, countNearHigh, rangePos, fmtUSD } from '../lib/stocks';
import { signedPct, fmtDay } from '../lib/indicators';
import type { StockCompany } from '../schemas';

interface Props {
  locale?: Locale;
}
const { locale = 'es' } = Astro.props;
const t = useTranslations(locale);

const total = stocks.companies.length;
const top3 = topPerformers(3);
const ext = extremes();
const nearHigh = countNearHigh();

/** Cierres mensuales → polilínea + punto final, misma gramática que Pulso. */
function coords(vals: number[], w: number, h: number, pad: number) {
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  const span = max - min || 1;
  const xy = vals.map((v, i) => ({
    x: pad + (i / (vals.length - 1)) * (w - pad * 2),
    y: pad + (1 - (v - min) / span) * (h - pad * 2),
  }));
  return { poly: xy.map(({ x, y }) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), last: xy.at(-1)! };
}

const SW = 320;
const SH = 44;
const SPAD = 5;

const sparkOf = (c: StockCompany) =>
  c.series.length >= 2 ? coords(c.series, SW, SH, SPAD) : null;

const changeOf = (c: StockCompany) => signedPct(c.change1yPct);
---

{
  total > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 md:py-36">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold leading-tight text-graphite-100 sm:text-4xl">
          {t('stocks.title')}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-graphite-400">{t('stocks.lead')}</p>
      </div>

      {
        ext && (
          <div class="reveal mt-10 rounded-2xl border border-graphite-800 bg-graphite-900 p-4 sm:p-5">
            <h3 class="font-display text-sm font-semibold text-graphite-100">
              {t('stocks.analysis.title')}
            </h3>
            <div class="mt-3 flex flex-wrap items-end gap-x-10 gap-y-4">
              <div class="min-w-0">
                <p class="text-[11px] text-graphite-400">{t('stocks.analysis.top')}</p>
                <p class="mt-0.5 truncate text-xs font-medium text-graphite-200">
                  {ext.top.name} · {ext.top.ticker}
                </p>
                <p class="font-display text-2xl font-semibold text-brand-400">{changeOf(ext.top)}%</p>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-graphite-400">{t('stocks.analysis.bottom')}</p>
                <p class="mt-0.5 truncate text-xs font-medium text-graphite-200">
                  {ext.bottom.name} · {ext.bottom.ticker}
                </p>
                <p class="font-display text-2xl font-semibold text-graphite-100">
                  {changeOf(ext.bottom)}%
                </p>
              </div>
              <div class="min-w-0">
                <p class="text-[11px] text-graphite-400">{t('stocks.analysis.nearHigh')}</p>
                <p class="font-display text-2xl font-semibold text-graphite-100">
                  {nearHigh}
                  <span class="text-base font-normal text-graphite-400"> / {total}</span>
                </p>
                <p class="text-[10px] text-graphite-400">{t('stocks.analysis.nearHighHint')}</p>
              </div>
            </div>
          </div>
        )
      }

      <div class="mt-3">
        <h3 class="font-display text-lg font-semibold text-graphite-100">{t('stocks.top3.title')}</h3>
        <p class="mt-1 text-xs text-graphite-400">{t('stocks.top3.lead')}</p>
      </div>

      <div class="reveal mt-4 grid gap-4 md:grid-cols-3">
        {
          top3.map((c) => {
            const spark = sparkOf(c);
            const pos = rangePos(c);
            const change = changeOf(c);
            const positive = (c.change1yPct ?? 0) > 0;
            return (
              <article class="flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <h3 class="font-display text-base font-semibold leading-snug text-graphite-100">
                      {c.name}
                    </h3>
                    <p class="text-[11px] text-graphite-400">
                      {c.ticker} · {c.exchange}
                    </p>
                  </div>
                  <span class="shrink-0 rounded-full border border-graphite-600 bg-graphite-850 px-2 py-0.5 text-[10px] font-medium text-graphite-300">
                    {c.metal}
                  </span>
                </div>
                {spark && (
                  <svg
                    viewBox={`0 0 ${SW} ${SH}`}
                    preserveAspectRatio="none"
                    class="h-14 w-full"
                    role="img"
                    aria-label={`${c.name} (${c.ticker}): ${fmtUSD(c.price)} hoy; ${change}% en el año.`}
                  >
                    <polyline
                      points={spark.poly}
                      fill="none"
                      stroke="#C6CEDD"
                      stroke-width="1.5"
                      vector-effect="non-scaling-stroke"
                    />
                    <circle cx={spark.last.x} cy={spark.last.y} r="3" fill="#FFC247" />
                  </svg>
                )}
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <p class="font-display text-2xl font-semibold text-graphite-100">{fmtUSD(c.price)}</p>
                  {change && (
                    <span
                      class:list={[
                        'shrink-0 rounded-full border px-2.5 py-1 text-[11px] font-medium',
                        positive
                          ? 'border-brand-600/60 bg-brand-500/10 text-brand-400'
                          : 'border-graphite-600 bg-graphite-850 text-graphite-300',
                      ]}
                    >
                      {change}% {t('stocks.year')}
                    </span>
                  )}
                </div>
                {pos != null && (
                  <div>
                    <div class="relative h-1.5 rounded-full bg-graphite-800" aria-hidden="true">
                      <span
                        class="absolute top-1/2 size-2.5 -translate-y-1/2 rounded-full border-2 border-graphite-900 bg-graphite-100"
                        style={`left:${Math.round(pos * 100)}%`}
                      />
                    </div>
                    <div class="mt-1 flex justify-between text-[10px] text-graphite-400">
                      <span>mín {fmtUSD(c.low52w ?? 0)}</span>
                      <span>máx {fmtUSD(c.high52w ?? 0)}</span>
                    </div>
                  </div>
                )}
                <p class="mt-auto text-[11px] leading-snug text-graphite-400">
                  {t('stocks.mines')}: {c.mines}
                </p>
              </article>
            );
          })
        }
      </div>

      <p class="mt-6 text-xs leading-snug text-graphite-300">
        {t('pulse.fuente')}: <a
          href={stocks.source.officialUrl}
          target="_blank"
          rel="noopener nofollow"
          class="text-graphite-200 transition-colors hover:text-brand-400">{stocks.source.name}</a
        > · {t('stocks.snapshot', { date: fmtDay(stocks.generatedAt) })} · {t('stocks.disclaimer')}
      </p>

      <a
        href="/bolsa"
        class="mt-3 inline-block text-sm font-semibold text-brand-400 hover:text-brand-300"
      >
        {t('stocks.cta')} →
      </a>
    </section>
  )
}
