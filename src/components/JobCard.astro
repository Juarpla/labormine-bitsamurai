---
import type { Job } from '../schemas';
import { useTranslations, countryName, type Locale } from '../lib/i18n';
import { formatSalary, formatDate } from '../lib/jobs';

interface Props {
  job: Job;
  locale?: Locale;
  eager?: boolean;
}

const { job, locale = 'en', eager = false } = Astro.props;
const t = useTranslations(locale);
const href = locale === 'en' ? `/jobs/${job.slug}` : `/${locale}/jobs/${job.slug}`;
---

<article
  class="job-card flex flex-col gap-3 rounded-2xl border border-graphite-800 bg-graphite-900 p-5"
  data-country={job.country}
  data-category={job.category}
  data-type={job.remote ? 'remote' : 'onsite'}
  data-visa={job.visaReported ? '1' : '0'}
  data-search={`${job.title} ${job.company} ${job.city ?? ''} ${job.locationRaw}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold leading-snug text-graphite-100">
      <a href={href} data-drawer-job={job.id} class="hover:text-brand-400">{job.title}</a>
    </h3>
    {job.visaReported && (
      <span class="shrink-0 rounded-full border border-brand-600/60 bg-brand-500/10 px-2.5 py-1 text-[11px] font-medium text-brand-400">
        ✦ {t('card.visa')}
      </span>
    )}
  </div>

  <p class="text-sm text-graphite-200">
    <span class="font-medium">{job.company}</span>
    <span class="text-graphite-400"> · {job.city ?? t('card.global')} · {countryName(job.country)}</span>
  </p>

  <div class="mt-auto flex flex-wrap items-center gap-2 text-xs text-graphite-400">
    <span class="rounded-full bg-graphite-800 px-2.5 py-1">{job.category}</span>
    {
      job.remote && (
        <span class="rounded-full bg-graphite-800 px-2.5 py-1 text-brand-300">↗ {t('card.remote')}</span>
      )
    }
    {
      job.salary && <span class="rounded-full bg-graphite-800 px-2.5 py-1">{formatSalary(job)}</span>
    }
    <time datetime={job.postedAt} class="ml-auto">{formatDate(job.postedAt, locale)}</time>
  </div>
</article>
