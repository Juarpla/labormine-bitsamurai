---
import type { Job } from '../schemas';
import { useTranslations, type Locale } from '../lib/i18n';
import { formatSalary, formatDate, titleFor, isAutoTranslated, locationLine, tierOf } from '../lib/jobs';

interface Props {
  job: Job;
  locale?: Locale;
  eager?: boolean;
  variant?: 'default' | 'compact';
}

const { job, locale = 'es', eager = false, variant = 'default' } = Astro.props;
const compact = variant === 'compact';
const t = useTranslations(locale);
const href = locale === 'es' ? `/jobs/${job.slug}` : `/${locale}/jobs/${job.slug}`;
const shownTitle = titleFor(job, locale);
const autoTranslated = isAutoTranslated(job, locale);
---

<article
  class:list={[
    'job-card flex flex-col rounded-2xl border border-graphite-800 bg-graphite-900',
    compact ? 'gap-2 p-4' : 'gap-3 p-5',
  ]}
  data-country={job.country}
  data-tier={String(tierOf(job))}
  data-category={job.category}
  data-type={job.remote ? 'remote' : 'onsite'}
  data-visa={job.visaReported ? '1' : '0'}
  data-search={`${job.title} ${job.company} ${job.city ?? ''} ${job.locationRaw}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <h3
      class:list={['font-display font-semibold leading-snug text-graphite-100', compact ? 'text-sm' : 'text-lg']}
    >
      <a href={href} data-drawer-job={job.id} class="hover:text-brand-400">{shownTitle}</a>
      {autoTranslated && (
        <span class="mt-1 block text-[10px] font-medium uppercase tracking-wide text-graphite-500" title={job.title}>
          ✦ {t('job.autoTranslated')}
        </span>
      )}
    </h3>
    {job.visaReported && (
      <span
        class:list={[
          'shrink-0 rounded-full border border-brand-600/60 bg-brand-500/10 font-medium text-brand-400',
          compact ? 'px-2 py-0.5 text-[10px]' : 'px-2.5 py-1 text-[11px]',
        ]}
      >
        ✦ {t('card.visa')}
      </span>
    )}
    {job.openToInternational && !job.visaReported && (
      <span
        class:list={[
          'shrink-0 rounded-full border border-brand-600/60 bg-brand-500/10 font-medium text-brand-400',
          compact ? 'px-2 py-0.5 text-[10px]' : 'px-2.5 py-1 text-[11px]',
        ]}
      >
        ✦ {t('card.international')}
      </span>
    )}
  </div>

  <p class:list={['text-graphite-200', compact ? 'text-xs' : 'text-sm']}>
    <span class="font-medium">{job.company}</span>
    <span class="text-graphite-400"> · {locationLine(job, t)}</span>
  </p>

  <div class:list={['mt-auto flex flex-wrap items-center gap-2 text-graphite-400', compact ? 'text-[11px]' : 'text-xs']}>
    <span class="rounded-full bg-graphite-800 px-2.5 py-1">{job.category}</span>
    {
      job.remote && (
        <span class="rounded-full bg-graphite-800 px-2.5 py-1 text-brand-300">↗ {t('card.remote')}</span>
      )
    }
    {
      job.salary && (
        <span class="rounded-full border border-brand-600/50 bg-brand-500/10 px-2.5 py-1 font-semibold text-brand-300">
          {formatSalary(job)}
        </span>
      )
    }
    <time datetime={job.postedAt} class="ml-auto">{formatDate(job.postedAt, locale)}</time>
  </div>
</article>
